{
  "expo": {
    "name": "EVCHARGEX",
    "slug": "EVCHARGEX-Mobile",
    "scheme": "evchargex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.evchargex.rider"
    },
    "android": {
      "package": "com.evchargex.rider",
      "adaptiveIcon": {
        "backgroundColor": "#1E63F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo-white.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#1E63F0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "98ea726e-8f8c-441f-bff1-3771507b8071"
      }
    },
    "owner": "manoj-evit"
  }
}
